# Copy to .env.production on the server; fill secrets there, chmod 600.
# Docker Compose 2.30+ reads this file literally (including $ in passwords).
# Do not quote values. Compose overrides MYSQL_HOST and APP_COOKIE_SECURE.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=algo_orb
MYSQL_PASSWORD=replace_with_database_password
MYSQL_DATABASE=algo_orb

APP_USERNAME=admin
APP_PASSWORD=replace_with_unique_admin_password
APP_SESSION_SECRET=replace_with_at_least_32_random_characters
APP_COOKIE_SECURE=true

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://rel.munchaana.com/auth/upstox/callback

# Execution mode and live enablement are managed in the dashboard (MySQL).
ORB_EXECUTION_BACKEND=gtt
ORB_BROKER_USER_ID=
ORB_MAX_PREMIUM=
ORB_MAX_NOTIONAL=
# Current five-point stop x two 500-unit lots = 5000; equality is allowed.
ORB_MAX_PLANNED_LOSS=5000
ORB_MAX_SPREAD=1
ORB_MAX_SLIPPAGE=1
ORB_QUOTE_MAX_AGE_SECONDS=5
ORB_POLL_SECONDS=2
ORB_PROTECTIVE_STOP_VERIFIED=false

# Optional PIN/TOTP token retrieval. Keep these values secret.
# Base32 setup key from TOTP enrolment, NOT the changing six-digit code.
UPSTOX_TOTP_SECRET=
# Six-digit account PIN; retain leading zeros.
UPSTOX_TOTP_PIN=
# ORB_BROKER_USER_ID above must match the account owning the live API key.

APP_ENV=production
APP_SESSION_SECRET=replace-with-a-long-random-secret
APP_COOKIE_SECURE=true
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-strong-password
APP_SESSION_TTL_SECONDS=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=algo_orb
MYSQL_PASSWORD=replace-with-the-database-password
MYSQL_DATABASE=algo_orb

UPSTOX_ENVIRONMENT=live
UPSTOX_SANDBOX_API_KEY=replace-with-sandbox-key
UPSTOX_SANDBOX_API_SECRET=replace-with-sandbox-secret
UPSTOX_SANDBOX_REDIRECT_URI=http://localhost:8000/auth/upstox/callback
UPSTOX_LIVE_API_KEY=replace-with-live-key
UPSTOX_LIVE_API_SECRET=replace-with-live-secret
UPSTOX_LIVE_REDIRECT_URI=https://your-domain.example/auth/upstox/callback
UPSTOX_ACCOUNT_USER_ID=replace-with-broker-user-id

TRADING_MODE=paper
TRADING_ENABLED=false
ORDER_MAX_NOTIONAL=10000
ORDER_MAX_QUANTITY=1000

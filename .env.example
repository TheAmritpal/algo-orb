MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=algo_orb
MYSQL_PASSWORD=replace_with_your_password
MYSQL_DATABASE=algo_orb

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/upstox/callback

# Optional explicit live app names; configure key and secret together.
# When absent, UPSTOX_API_KEY/SECRET/REDIRECT_URI above remain the live app.
UPSTOX_LIVE_API_KEY=
UPSTOX_LIVE_API_SECRET=
UPSTOX_LIVE_REDIRECT_URI=http://localhost:8000/auth/upstox/callback

# Independent sandbox app. Generate its token in the Upstox sandbox portal.
# Sandbox does not use the live authorization-code callback.
UPSTOX_SANDBOX_API_KEY=
# Optional pin for CLI probes. Without it, use the latest sandbox account only.
# Manual token imports use the local identifier sandbox when this is absent.
# UPSTOX_SANDBOX_USER_ID=sandbox
UPSTOX_SANDBOX_MAX_QUANTITY=1
UPSTOX_SANDBOX_MAX_NOTIONAL=1000

# Website administrator: run python -m app.cli.sync_admin after migrations.
APP_USERNAME=admin
APP_PASSWORD=
APP_SESSION_SECRET=
# Use true with HTTPS outside local development.
APP_COOKIE_SECURE=false

# RELIANCE strategy worker. Default execution is simulated.
# Execution mode and live enablement are managed in the dashboard (MySQL).
# GTT holds TP/SL at Upstox. "orders" retains ordinary-order execution.
ORB_EXECUTION_BACKEND=gtt
ORB_BROKER_USER_ID=
# Explicit "none" disables only PREMIUM or NOTIONAL caps. Blank is unconfigured.
# Available funds, the planned-loss cap and spread checks still apply.
ORB_MAX_PREMIUM=
ORB_MAX_NOTIONAL=
ORB_MAX_PLANNED_LOSS=
ORB_MAX_SPREAD=
ORB_MAX_SLIPPAGE=
ORB_QUOTE_MAX_AGE_SECONDS=5
ORB_POLL_SECONDS=2

# Explicit account/product protection verification; mocks do not verify it.
# Live entries additionally require active NFO, D, LIMIT and SL profile permissions.
# Do not set true solely because profile or GTT read requests succeed.
# Upstox currently does not support GTT in sandbox.
ORB_PROTECTIVE_STOP_VERIFIED=false

# Optional PIN/TOTP token retrieval. Keep these values secret.
# Base32 setup key from TOTP enrolment, NOT the changing six-digit code.
UPSTOX_TOTP_SECRET=
# Six-digit account PIN; retain leading zeros.
UPSTOX_TOTP_PIN=
# ORB_BROKER_USER_ID above must match the account owning the live API key.
